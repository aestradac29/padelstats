rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES AUXILIARES ---
    
    // Verifica si el usuario ha iniciado sesión en Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica si el usuario actual es el dueño del documento (por ID)
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- REGLAS DE COLECCIÓN: USERS ---
    match /users/{userId} {
      // Lectura: Permitida a autenticados. 
      allow read: if isSignedIn();
      
      // Escritura: Solo el propio usuario puede modificar su perfil
      allow write: if isOwner(userId);
    }

    // --- REGLAS DE COLECCIÓN: TEAMS ---
    match /teams/{teamId} {
      // Lectura: PÚBLICA. 
      // Necesario para que el "Modo Invitado" (sin login) pueda leer los datos del equipo.
      allow read: if true;

      // Escritura/Modificación: ESTRICTO.
      // Solo el Capitán (cuyo UID coincide con el ID del equipo) puede crear o editar.
      allow write: if isOwner(teamId);
    }
  }
}